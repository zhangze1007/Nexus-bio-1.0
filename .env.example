# Nexus-Bio 1.0 — Environment Variables
# Copy this file to .env.local and fill in your keys.
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your actual keys
#   npm run dev

# ─────────────────────────────────────────────────────────────────────
# Required — AI Provider Keys
# ─────────────────────────────────────────────────────────────────────

# Groq API (primary AI provider) — https://console.groq.com
GROQ_API_KEY=

# Google Gemini (fallback AI provider) — https://aistudio.google.com
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Optional — Authentication (Researcher Accounts)
# ─────────────────────────────────────────────────────────────────────

# Auth.js secret for JWT signing — generate with: openssl rand -base64 32
# AUTH_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# GITHUB_ID=
# GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# API key for programmatic access (X-API-Key header)
# NEXUS_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Optional — Single-Cell Spatial (ScSpatial) Python Integration
# ─────────────────────────────────────────────────────────────────────

# Directory for ScSpatial artifact storage (defaults to system temp)
# SCSPATIAL_ARTIFACT_DIR=

# Path to Python binary for ScSpatial sidecar (defaults to "python3")
# SCSPATIAL_PYTHON_BIN=

# Additional Python module paths (for custom scanpy/anndata installations)
# PYTHONPATH=

# ─────────────────────────────────────────────────────────────────────
# Optional — ESM-2 Protein Language Model Backend
# ─────────────────────────────────────────────────────────────────────

# URL of the Python ESM-2 backend (scspatial-backend with torch + fair-esm)
# Provides real 320-1280 dim per-residue embeddings. When not set,
# /api/esm2 falls back to ESM Atlas (PDB only) then local Atchley factors.
# Example: http://localhost:8000 or https://your-railway-app.up.railway.app
# ESM2_PYTHON_BACKEND=

# ─────────────────────────────────────────────────────────────────────
# Optional — Monitoring (Sentry)
# ─────────────────────────────────────────────────────────────────────

# Sentry DSN for error tracking — https://sentry.io
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────
# Optional — Rate Limiting (Upstash Redis)
# ─────────────────────────────────────────────────────────────────────

# Upstash Redis for persistent rate limiting across Vercel instances
# Get credentials at https://console.upstash.com
# When not set, falls back to in-memory rate limiting (single-instance only)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Optional — Database (persistent workbench)
# ─────────────────────────────────────────────────────────────────────

# Turso database URL (leave empty to use ephemeral SQLite)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Optional — File Storage (Cloudflare R2)
# ─────────────────────────────────────────────────────────────────────

# Cloudflare R2 is S3-compatible object storage (free tier: 10GB, $0 egress)
# Create a bucket and API token at https://dash.cloudflare.com > R2
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=nexus-bio-files

# ─────────────────────────────────────────────────────────────────────
# Auto-set by platform — do not set locally
# ─────────────────────────────────────────────────────────────────────
# NODE_ENV=development
# VERCEL=
# VERCEL_GIT_COMMIT_SHA=
