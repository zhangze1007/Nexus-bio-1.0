{
  "name": "nexus-bio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "biome check src/ --diagnostic-level=error",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "analyze": "ANALYZE=true npm run build",
    "benchmark:trust:validate": "node scripts/validateTrustBenchmarkCorpus.mjs",
    "benchmark:trust:evaluate": "jest __tests__/trustPolicyEngineBenchmark.test.ts --runInBand",
    "benchmark:trust:report": "tsx scripts/generateTrustMetricsReport.ts",
    "benchmark:public": "node scripts/runPublicBenchmark.mjs",
    "benchmark:performance": "node scripts/runPerformanceBenchmarks.mjs",
    "policy:dsl:validate": "node scripts/validatePolicyDsl.mjs",
    "proof:check": "node scripts/checkProofPackage.mjs",
    "proof:replay": "node scripts/replayProofPackage.mjs",
    "reference:py:validate": "python3 reference_impl_py/run_reference_benchmark.py validate",
    "reference:py:run": "python3 reference_impl_py/run_reference_benchmark.py run",
    "reference:py:compare": "python3 reference_impl_py/run_reference_benchmark.py compare",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@libsql/client": "^0.17.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@scalar/api-reference-react": "^0.9.48",
    "@sentry/nextjs": "^10.56.0",
    "@tanstack/react-query": "^5.101.1",
    "@types/d3": "^7.4.3",
    "@upstash/redis": "^1.38.0",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.11.1",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "highs": "^1.14.2",
    "lucide-react": "^0.546.0",
    "next": "^15.5.19",
    "next-auth": "5.0.0-beta.31",
    "onnxruntime-web": "^1.26.0",
    "posthog-js": "^1.393.5",
    "posthog-node": "^5.38.5",
    "pyodide": "^314.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.3.0",
    "three": "^0.183.2",
    "umap-js": "^1.4.0",
    "ws": "^8.21.0",
    "xstate": "^5.30.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "protobufjs": ">=7.4.0",
    "handlebars": ">=4.7.8",
    "brace-expansion": ">=2.0.1",
    "ws": "$ws",
    "postcss": ">=8.4.31"
  }
}
