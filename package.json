{
  "name": "nexus-bio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "analyze": "ANALYZE=true npm run build",
    "benchmark:trust:validate": "node scripts/validateTrustBenchmarkCorpus.mjs",
    "benchmark:trust:evaluate": "jest __tests__/trustPolicyEngineBenchmark.test.ts --runInBand",
    "benchmark:trust:report": "tsx scripts/generateTrustMetricsReport.ts",
    "benchmark:public": "node scripts/runPublicBenchmark.mjs",
    "benchmark:performance": "node scripts/runPerformanceBenchmarks.mjs",
    "policy:dsl:validate": "node scripts/validatePolicyDsl.mjs",
    "proof:check": "node scripts/checkProofPackage.mjs",
    "proof:replay": "node scripts/replayProofPackage.mjs",
    "reference:py:validate": "python3 reference_impl_py/run_reference_benchmark.py validate",
    "reference:py:run": "python3 reference_impl_py/run_reference_benchmark.py run",
    "reference:py:compare": "python3 reference_impl_py/run_reference_benchmark.py compare"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sentry/nextjs": "^10.56.0",
    "@upstash/redis": "^1.38.0",
    "@xstate/react": "^6.1.0",
    "framer-motion": "^12.38.0",
    "highs": "^1.14.2",
    "lucide-react": "^0.546.0",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.31",
    "onnxruntime-web": "^1.26.0",
    "pyodide": "^314.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "three": "^0.183.2",
    "umap-js": "^1.4.0",
    "ws": "^8.21.0",
    "xstate": "^5.30.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "protobufjs": ">=7.4.0",
    "handlebars": ">=4.7.8",
    "brace-expansion": ">=2.0.1",
    "ws": ">=8.17.1",
    "postcss": ">=8.4.31"
  }
}
