{
  "name": "nexus-bio",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for the Nexus-Bio synthetic biology AI platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "synthetic-biology",
    "bioinformatics",
    "nexus-bio",
    "metabolic-engineering",
    "fba",
    "sdk"
  ],
  "author": "Zhang Ze Foo <fuchanze@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangze1007/Nexus-bio-1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
